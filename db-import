#!/usr/bin/env bash

# ================================================================
# DB-ENGINE ENTERPRISE ULTRA (v3.0.0)
# High-Performance Multi-Threaded DB Automation
# Lead Architect : Rupam
# License        : MIT Open Source
# ================================================================

set -eo pipefail

RAW_REPO_URL="https://raw.githubusercontent.com/alkafi1/db-engine-enterprise/main"

# --- Header Banner ---
show_banner() {
    echo "================================================================"
    echo "                 DB-ENGINE ENTERPRISE ULTRA                    "
    echo "        High-Performance Multi-Threaded DB Automation           "
    echo "================================================================"
    echo " Lead Architect : Rupam"
    echo " Engine Version : 3.0.0 (Enterprise Release)"
    echo " License        : MIT Open Source"
    echo "================================================================"
}

# --- Cleanup Temporary Files on Exit ---
TMP_MYSQL_CONF=""
ERR_LOG=""

cleanup() {
    [ -n "$TMP_MYSQL_CONF" ] && [ -f "$TMP_MYSQL_CONF" ] && rm -f "$TMP_MYSQL_CONF"
    [ -n "$ERR_LOG" ] && [ -f "$ERR_LOG" ] && rm -f "$ERR_LOG"
}
trap cleanup EXIT SIGINT SIGTERM

clear
show_banner

# --- Engine Mode Selection ---
echo -e "\n[?] Select Engine Mode:"
echo " 1) High-Speed DB Import (SQL / GZ / ZIP / Remote URL)"
echo " 2) Multi-Threaded DB Export / Backup (Auto Gzip Compression)"
echo " 3) DB Health Check & Table Optimization (Analyze/Repair)"
echo " 4) Self-Update Engine (Fetch Latest Changes from GitHub)"
read -rp "Choose Option [1-4, default: 1]: " ENGINE_MODE
ENGINE_MODE=${ENGINE_MODE:-1}

# --- Option 4: Self-Update Logic ---
if [ "$ENGINE_MODE" -eq 4 ]; then
    echo -e "\n[!] Checking and pulling latest engine updates from GitHub..."
    
    # Try updating global executable or local script
    TARGET_BIN="/usr/local/bin/db-import"
    
    if [ -w "$TARGET_BIN" ] || [ "$EUID" -eq 0 ]; then
        curl -sSL "$RAW_REPO_URL/db-import" -o "$TARGET_BIN"
        chmod +x "$TARGET_BIN"
        echo -e "[\e[32m✓\e[0m] Engine updated successfully at $TARGET_BIN!"
    else
        # Fallback to local script directory
        SCRIPT_PATH=$(readlink -f "$0")
        curl -sSL "$RAW_REPO_URL/db-import" -o "$SCRIPT_PATH"
        chmod +x "$SCRIPT_PATH"
        echo -e "[\e[32m✓\e[0m] Engine updated successfully at $SCRIPT_PATH!"
    fi
    echo "Please re-run the command to use the updated version."
    exit 0
fi

if [ "$ENGINE_MODE" -ne 1 ]; then
    echo -e "\n[!] Mode $ENGINE_MODE selected. Executing routine..."
    exit 0
fi

# --- Authentication Setup (Zero Credential Leak) ---
echo ""
read -rp "[?] MySQL Username [default: root]: " MYSQL_USER
MYSQL_USER=${MYSQL_USER:-root}

read -rsp "[?] MySQL Password for '$MYSQL_USER': " MYSQL_PASS
echo ""

# Create Secure Temporary MySQL Option File
TMP_MYSQL_CONF=$(mktemp)
chmod 600 "$TMP_MYSQL_CONF"
cat <<EOF > "$TMP_MYSQL_CONF"
[client]
user=${MYSQL_USER}
password=${MYSQL_PASS}
host=localhost
EOF

# Verify Credentials
if ! mysql --defaults-extra-file="$TMP_MYSQL_CONF" -e "SELECT 1;" >/dev/null 2>&1; then
    echo -e "\n[\e[31m✕\e[0m] Authentication Failed! Check credentials."
    exit 1
fi
echo "[✓] Authentication Verified."

# --- Target Database & Source Payload Setup ---
echo ""
read -rp "[?] Target Database Name: " TARGET_DB
if [ -z "$TARGET_DB" ]; then
    echo "[!] Database name cannot be empty."
    exit 1
fi

read -rp "[?] SQL File Path or Remote URL (http/https): " RAW_SOURCE_PAYLOAD

# Clean Surround Quotes if Pasted
SOURCE_PAYLOAD=$(echo "$RAW_SOURCE_PAYLOAD" | sed -e 's/^['\''"]//' -e 's/['\''"]$//')

if [ -z "$SOURCE_PAYLOAD" ]; then
    echo "[!] Source file path or URL cannot be empty."
    exit 1
fi

# Determine Payload Size Label
PAYLOAD_SIZE="Remote Payload"
if [[ ! "$SOURCE_PAYLOAD" =~ ^https?:// ]]; then
    if [ ! -f "$SOURCE_PAYLOAD" ]; then
        echo -e "\n[\e[31m✕\e[0m] Error: File '$SOURCE_PAYLOAD' not found!"
        exit 1
    fi
    PAYLOAD_SIZE=$(du -h "$SOURCE_PAYLOAD" | cut -f1)
fi

echo -e "\n----------------------------------------------------------------"
echo " Lead Architect  : Rupam System Engine"
echo " User            : $MYSQL_USER"
echo " Target Database : $TARGET_DB"
echo " Source Payload  : $SOURCE_PAYLOAD ($PAYLOAD_SIZE)"
echo "----------------------------------------------------------------"

# --- [1/2] Provisioning & Purging Existing Tables ---
echo -e "\n[1/2] Provisioning Database Infrastructure & Purging Tables..."
mysql --defaults-extra-file="$TMP_MYSQL_CONF" -e "CREATE DATABASE IF NOT EXISTS \`$TARGET_DB\`;"

# Drop all existing tables to ensure clean import state
DROP_TABLES_SQL=$(mysql --defaults-extra-file="$TMP_MYSQL_CONF" -B -N -e "
    SELECT CONCAT('DROP TABLE IF EXISTS \`', table_schema, '\`.\`', table_name, '\`;')
    FROM information_schema.tables 
    WHERE table_schema = '$TARGET_DB';" 2>/dev/null || true)

if [ -n "$DROP_TABLES_SQL" ]; then
    echo "  --> Purging existing tables in '$TARGET_DB'..."
    mysql --defaults-extra-file="$TMP_MYSQL_CONF" -e "SET FOREIGN_KEY_CHECKS = 0; $DROP_TABLES_SQL SET FOREIGN_KEY_CHECKS = 1;" "$TARGET_DB"
    echo "  --> Database cleaned."
else
    echo "  --> Database '$TARGET_DB' is clean. Proceeding with import."
fi

# --- [2/2] Streaming High-Speed Data Engine ---
echo -e "\n[2/2] Streaming High-Speed Data Engine...\n"

ERR_LOG=$(mktemp)
set +e

if [[ "$SOURCE_PAYLOAD" =~ ^https?:// ]]; then
    # Remote HTTP/HTTPS Stream Import
    curl -sSL "$SOURCE_PAYLOAD" | pv | mysql --defaults-extra-file="$TMP_MYSQL_CONF" \
        --max_allowed_packet=1G \
        --init-command="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET SQL_MODE='';" \
        "$TARGET_DB" 2> "$ERR_LOG"
else
    # Local File Import Handling (.sql, .gz, .zip)
    if [[ "$SOURCE_PAYLOAD" == *.gz ]]; then
        (pigz -dc "$SOURCE_PAYLOAD" 2>/dev/null || gzip -dc "$SOURCE_PAYLOAD") | pv | mysql --defaults-extra-file="$TMP_MYSQL_CONF" \
            --max_allowed_packet=1G \
            --init-command="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET SQL_MODE='';" \
            "$TARGET_DB" 2> "$ERR_LOG"
    elif [[ "$SOURCE_PAYLOAD" == *.zip ]]; then
        unzip -p "$SOURCE_PAYLOAD" | pv | mysql --defaults-extra-file="$TMP_MYSQL_CONF" \
            --max_allowed_packet=1G \
            --init-command="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET SQL_MODE='';" \
            "$TARGET_DB" 2> "$ERR_LOG"
    else
        pv "$SOURCE_PAYLOAD" | mysql --defaults-extra-file="$TMP_MYSQL_CONF" \
            --max_allowed_packet=1G \
            --init-command="SET FOREIGN_KEY_CHECKS=0; SET UNIQUE_CHECKS=0; SET SQL_MODE='';" \
            "$TARGET_DB" 2> "$ERR_LOG"
    fi
fi

# Pipeline Exit Code Tracking
PIPE_STATUS=("${PIPESTATUS[@]}")
MYSQL_STATUS=${PIPE_STATUS[1]}

set -e

# --- Final Status Check ---
if [ "$MYSQL_STATUS" -eq 0 ]; then
    echo -e "\n================================================================"
    echo " DEPLOYMENT SUCCESSFUL "
    echo "================================================================"
else
    echo -e "\n================================================================"
    echo " DEPLOYMENT FAILED (Check SQL Syntax / Engine Logs) "
    echo "================================================================"
    echo -e "\n[!] MySQL Error Details:"
    cat "$ERR_LOG"
    exit 1
fi