set -o pipefail

# Color Palette
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

LOG_FILE="$HOME/.db_engine.log"

log_action() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

show_banner() {
    clear
    echo -e "${PURPLE}${BOLD}================================================================${NC}"
    echo -e "${CYAN}${BOLD}                 DB-ENGINE ENTERPRISE ULTRA                     ${NC}"
    echo -e "${BLUE}${BOLD}        High-Performance Multi-Threaded DB Automation           ${NC}"
    echo -e "${PURPLE}${BOLD}================================================================${NC}"
    echo -e " ${BOLD}Lead Architect :${NC} ${GREEN}${BOLD}Rupam${NC}"
    echo -e " ${BOLD}Engine Version :${NC} 3.0.0 (Enterprise Release)"
    echo -e " ${BOLD}License        :${NC} MIT Open Source"
    echo -e "${PURPLE}${BOLD}================================================================${NC}"
    echo ""
}

check_dependencies() {
    local deps=("pv" "mysql" "mysqldump" "stat" "du" "pigz" "curl")
    local missing=()

    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            missing+=("$dep")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${YELLOW}[!] Installing required enterprise components: ${missing[*]}...${NC}"
        sudo apt-get update -qq && sudo apt-get install -y "${missing[@]}" -qq 2>/dev/null
        echo -e "${GREEN}[✓] Dependencies initialized.${NC}\n"
    fi
}

detect_dotenv() {
    if [ -f ".env" ]; then
        echo -e "${GREEN}[★] Auto-detected local .env workspace config.${NC}"
        ENV_DB_NAME=$(grep -E '^DB_DATABASE=' .env | head -n 1 | cut -d '=' -f2 | tr -d '"' | tr -d "'\r")
        ENV_DB_USER=$(grep -E '^DB_USERNAME=' .env | head -n 1 | cut -d '=' -f2 | tr -d '"' | tr -d "'\r")
        ENV_DB_PASS=$(grep -E '^DB_PASSWORD=' .env | head -n 1 | cut -d '=' -f2 | tr -d '"' | tr -d "'\r")
    fi
}

show_banner
check_dependencies
detect_dotenv

# Menu System
echo -e "${YELLOW}[?] Select Engine Mode:${NC}"
echo " 1) High-Speed DB Import (SQL / GZ / ZIP / Remote URL)"
echo " 2) Multi-Threaded DB Export / Backup (Auto Gzip Compression)"
echo " 3) DB Health Check & Table Optimization (Analyze/Repair)"
read -p "$(echo -e ${BOLD}"Choose Option [1-3, default: 1]: "${NC})" OPER_MODE
OPER_MODE=${OPER_MODE:-1}

echo ""

# Auth Credentials
DEFAULT_USER=${ENV_DB_USER:-root}
read -p "$(echo -e ${YELLOW}"[?] MySQL Username [default: ${DEFAULT_USER}]: "${NC})" DB_USER
DB_USER=${DB_USER:-$DEFAULT_USER}

if [ -n "$ENV_DB_PASS" ]; then
    read -sp "$(echo -e ${YELLOW}"[?] MySQL Password for '${DB_USER}' (Press Enter for .env password): "${NC})" DB_PASS
    echo ""
    DB_PASS=${DB_PASS:-$ENV_DB_PASS}
else
    read -sp "$(echo -e ${YELLOW}"[?] MySQL Password for '${DB_USER}': "${NC})" DB_PASS
    echo ""
fi

export MYSQL_PWD="$DB_PASS"

if ! mysql -u"$DB_USER" -e ";" 2>/dev/null; then
    echo -e "${RED}[X] Authentication Failed for user '$DB_USER'.${NC}"
    unset MYSQL_PWD
    exit 1
fi
echo -e "${GREEN}[✓] Authentication Verified.${NC}\n"

# --- MODE 1: IMPORT ---
if [ "$OPER_MODE" -eq 1 ]; then

    DEFAULT_DB=${ENV_DB_NAME:-""}
    if [ -n "$DEFAULT_DB" ]; then
        read -p "$(echo -e ${YELLOW}"[?] Target Database Name [default: ${DEFAULT_DB}]: "${NC})" DB_NAME
        DB_NAME=${DB_NAME:-$DEFAULT_DB}
    else
        read -p "$(echo -e ${YELLOW}"[?] Target Database Name: "${NC})" DB_NAME
    fi

    if [ -z "$DB_NAME" ]; then
        echo -e "${RED}[X] Database name is required.${NC}"
        unset MYSQL_PWD
        exit 1
    fi

    read -p "$(echo -e ${YELLOW}"[?] SQL File Path or Remote URL (http/https): "${NC})" RAW_SQL_PATH
    SQL_INPUT=$(echo "$RAW_SQL_PATH" | tr -d "'\"")

    # Download from URL if HTTP/HTTPS provided
    if [[ "$SQL_INPUT" =~ ^https?:// ]]; then
        echo -e "${CYAN}[->] Remote URL detected. Downloading dump...${NC}"
        TEMP_SQL="/tmp/downloaded_dump_$(date +%s).sql"
        curl -sL "$SQL_INPUT" -o "$TEMP_SQL"
        SQL_FILE="$TEMP_SQL"
    else
        SQL_FILE="$SQL_INPUT"
    fi

    if [ ! -f "$SQL_FILE" ]; then
        echo -e "${RED}[X] Dump file '$SQL_FILE' not found.${NC}"
        unset MYSQL_PWD
        exit 1
    fi

    FILE_SIZE_BYTES=$(stat -c%s "$SQL_FILE")
    FILE_SIZE_HUMAN=$(du -h "$SQL_FILE" | cut -f1)

    echo -e "\n${CYAN}----------------------------------------------------------------${NC}"
    echo -e " Lead Architect  : ${BOLD}Rupam System Engine${NC}"
    echo -e " User            : ${BOLD}${DB_USER}${NC}"
    echo -e " Target Database : ${BOLD}${DB_NAME}${NC}"
    echo -e " Source Payload  : ${BOLD}${SQL_FILE}${NC} (${FILE_SIZE_HUMAN})"
    echo -e "${CYAN}----------------------------------------------------------------${NC}\n"

    # Provision Database
    echo -e "${YELLOW}[1/2] Provisioning Database Infrastructure...${NC}"
    DB_EXISTS=$(mysql -u"$DB_USER" -e "SHOW DATABASES LIKE '$DB_NAME';" 2>/dev/null | grep "$DB_NAME")

    if [ -z "$DB_EXISTS" ]; then
        mysql -u"$DB_USER" -e "CREATE DATABASE \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>/dev/null
        echo -e "  --> Database '${DB_NAME}' created with UTF8MB4 encoding."
    else
        echo -e "  --> Database '${DB_NAME}' found. Proceeding with import."
    fi

    echo -e "\n${YELLOW}[2/2] Streaming High-Speed Data Engine...${NC}\n"
    START_TIME=$(date +%s)

    # Temporary Performance Tweaks for Session
    MYSQL_OPT="--max_allowed_packet=1G --net_buffer_length=10M --quick"

    if [[ "$SQL_FILE" == *.gz ]]; then
        pigz -dc "$SQL_FILE" | pv -t -r -b -p -s "$FILE_SIZE_BYTES" | mysql -u"$DB_USER" $MYSQL_OPT "$DB_NAME" 2>/dev/null
    else
        pv -t -r -b -p -s "$FILE_SIZE_BYTES" "$SQL_FILE" | mysql -u"$DB_USER" $MYSQL_OPT "$DB_NAME" 2>/dev/null
    fi

    if [ $? -eq 0 ]; then
        END_TIME=$(date +%s)
        DURATION=$((END_TIME - START_TIME))
        echo -e "\n${GREEN}${BOLD}================================================================"${NC}
        echo -e "${GREEN}${BOLD} DEPLOYMENT SUCCESSFUL [Completed in ${DURATION}s]                 "${NC}
        echo -e "${GREEN}${BOLD}================================================================"${NC}
        log_action "Imported $SQL_FILE into $DB_NAME in ${DURATION}s"
    else
        echo -e "\n${RED}${BOLD}================================================================"${NC}
        echo -e "${RED}${BOLD} DEPLOYMENT FAILED (Check SQL Syntax / Engine Logs)              "${NC}
        echo -e "${RED}${BOLD}================================================================"${NC}
        log_action "Failed to import $SQL_FILE into $DB_NAME"
    fi

    # Cleanup temp download if exists
    [ -n "$TEMP_SQL" ] && rm -f "$TEMP_SQL"

# --- MODE 2: EXPORT ---
elif [ "$OPER_MODE" -eq 2 ]; then

    read -p "$(echo -e ${YELLOW}"[?] Database Name to Export: "${NC})" DB_NAME
    read -p "$(echo -e ${YELLOW}"[?] Output File Path [default: ./${DB_NAME}_backup.sql.gz]: "${NC})" OUT_PATH
    OUT_PATH=${OUT_PATH:-"./${DB_NAME}_backup.sql.gz"}

    echo -e "\n${YELLOW}[1/1] Streaming Multi-Threaded Compressed Backup...${NC}"
    START_TIME=$(date +%s)

    mysqldump -u"$DB_USER" --single-transaction --quick --max_allowed_packet=1G "$DB_NAME" 2>/dev/null | pigz > "$OUT_PATH"

    if [ $? -eq 0 ]; then
        END_TIME=$(date +%s)
        DURATION=$((END_TIME - START_TIME))
        FILE_SIZE_HUMAN=$(du -h "$OUT_PATH" | cut -f1)
        echo -e "\n${GREEN}${BOLD}================================================================"${NC}
        echo -e "${GREEN}${BOLD} EXPORT SUCCESSFUL [Size: ${FILE_SIZE_HUMAN} | Time: ${DURATION}s]       "${NC}
        echo -e "${GREEN}${BOLD} Saved to: ${OUT_PATH}${NC}"
        echo -e "${GREEN}${BOLD}================================================================"${NC}
        log_action "Exported $DB_NAME to $OUT_PATH in ${DURATION}s"
    else
        echo -e "${RED}[X] Export Failed.${NC}"
        log_action "Failed export for $DB_NAME"
    fi

# --- MODE 3: HEALTH & OPTIMIZE ---
elif [ "$OPER_MODE" -eq 3 ]; then

    read -p "$(echo -e ${YELLOW}"[?] Database Name to Optimize: "${NC})" DB_NAME
    echo -e "\n${YELLOW}[1/1] Optimizing and repairing database tables...${NC}"

    mysqlcheck -u"$DB_USER" --auto-repair --optimize --analyze "$DB_NAME" 2>/dev/null

    if [ $? -eq 0 ]; then
        echo -e "\n${GREEN}[✓] Database '${DB_NAME}' successfully optimized.${NC}"
        log_action "Optimized database $DB_NAME"
    else
        echo -e "\n${RED}[X] Database optimization failed.${NC}"
    fi

fi

unset MYSQL_PWD
